{{!< default}}

{{!-- Grid pattern --}}
<div class="absolute -z-10 top-10 start-0 w-full h-70 bg-grid-gray-950 dark:bg-grid-gray-50 bg-grid-size-10 dark:bg-grid-size-10 lg:bg-grid-size-15 dark:lg:bg-grid-size-15 mask-radial mask-position-to-80% opacity-5 dark:opacity-10 pointer-events-none"></div>


{{!-- Hero section --}}
{{#page}}
    {{> hero-narrow isCenter=true hideMeta=true }}
{{/page}}



{{#post}}
<div class="outer xl:outer-xl">
    <div class="inner">
        <div class="max-w-5xl mx-auto grid mb-20">
            <div class="w-full min-w-0 max-w-2xl sm:mx-auto">
                {{!-- Content --}}
                <div data-sx-toc-src>
                    {{!-- Fix for tocbot always having the first link active even if the heading is not yet visible https://github.com/tscanlin/tocbot/issues/217 --}}
                    <h2 id="___TOCBOT___" class="sr-only m-0">
                        <span aria-hidden="true">{{title}}</span>
                    </h2>  

                    <div class="content has-full has-wide">
                        {{content}}                     

                        {{#if access}}
                            {{#foreach tags visibility="internal"}}
                                {{#match slug "~^" "hash-forms-contact"}}
                                    {{#if canonical_url}}
                                        <form 
                                            id="sx-contact" 
                                            class="flex flex-col text-base leading-7"
                                            action="{{canonical_url}}" 
                                            method="post"
                                        >
                                            <label 
                                                for="sx-contact-name"
                                                class="mb-1 font-medium text-gray-900 dark:text-gray-100" 
                                            >
                                                {{t "Name"}}                                
                                            </label>
                                            <input 
                                                id="sx-contact-name" 
                                                class="mb-4 px-4 py-2.5 bg-white dark:bg-white/5 rounded-2xl ring-1 ring-inset ring-gray-950/10 dark:ring-gray-50/10 focus:outline-none focus:ring-2 focus:ring-gray-950/15 dark:focus:ring-gray-50/15 shadow-xs dark:shadow-none" 
                                                type="text" 
                                                name="name" 
                                                required 
                                            />

                                            <label 
                                                for="sx-contact-email"
                                                class="mb-1 font-medium text-gray-900 dark:text-gray-100" 
                                            >
                                                {{t "Email address"}}
                                            </label>
                                            <input 
                                                id="sx-contact-email" 
                                                class="mb-4 px-4 py-2.5 bg-white dark:bg-white/5 rounded-2xl ring-1 ring-inset ring-gray-950/10 dark:ring-gray-50/10 focus:outline-none focus:ring-2 focus:ring-gray-950/15 dark:focus:ring-gray-50/15 shadow-xs dark:shadow-none" 
                                                type="email" 
                                                name="_replyto" 
                                                required
                                            />
                                            
                                            <input 
                                                id="sx-contact-subject" 
                                                type="hidden" 
                                                name="_subject" 
                                                value="{{#if description}}{{description}}{{else}}Contact Form Submission{{/if}}" 
                                            />

                                            <label 
                                                for="sx-contact-message"
                                                class="mb-1 font-medium text-gray-900 dark:text-gray-100" 
                                            >
                                                {{t "Message"}}
                                            </label>
                                            <textarea 
                                                id="sx-contact-message" 
                                                class="mb-4 px-4 py-2.5 bg-white dark:bg-white/5 rounded-2xl ring-1 ring-inset ring-gray-950/10 dark:ring-gray-50/10 focus:outline-none focus:ring-2 focus:ring-gray-950/15 dark:focus:ring-gray-50/15 shadow-xs dark:shadow-none" 
                                                rows="9" 
                                                name="message" 
                                                required
                                            ></textarea>

                                            {{!-- Honeypot --}}
                                            <input type="text" name="_gotcha" style="display:none" />

                                            <button 
                                                id="sx-contact-submit"
                                                type="submit"
                                                class="flex items-center text-center h-auto min-w-28 mt-1.5 me-auto py-2 px-5 font-medium leading-snug rounded-3xl opacity-100 shadow-primary 
                                                    dark:shadow-none dark:drop-shadow-primary-sm bg-accent text-accent-contrast cursor-pointer transition-opacity duration-200 hover:opacity-90
                                                " 
                                            >
                                                {{t "Send message"}}
                                                {{> icons/loader class="w-5 h-5 ms-1 -me-0.5 hidden [.loading>&]:inline"}}
                                            </button>

                                            <div id="sx-contact-status" class="mt-8 kg-card kg-callout-card" role="alert">
                                                <div class="kg-callout-text"></div>
                                            </div>                                            
                                        </form>  

                                        <script>
                                            const formURL = `{{canonical_url}}`;
                                            const form = document.getElementById("sx-contact");
                                            const btn = document.getElementById("sx-contact-submit");
                                            const name = document.getElementById("sx-contact-name");
                                            const email = document.getElementById("sx-contact-email");
                                            const message = document.getElementById("sx-contact-message");
                                            const status = document.getElementById("sx-contact-status");
                                            const statusText = status?.querySelector(".kg-callout-text");

                                            const successMessage = `✓ {{t "Thanks! Your message was sent successfully."}}`;
                                            const errorMessage = `{{t "Something went wrong, please try again."}}`;
                                            const validationMessage = `{{t "Please fill in all required fields."}}`;

                                            
                                            function handleSubmit(event) {
                                                event.preventDefault();
                                                const data = new FormData(event.target);

                                                if (!name.value.trim() || !email.value.trim() || !message.value.trim()) {
                                                    statusText.textContent = validationMessage;
                                                    status.classList.add('kg-callout-card-red');
                                                    return;
                                                }

                                                statusText.textContent = "";
                                                status.classList.remove('kg-callout-card-red', 'kg-callout-card-green');
                                                btn.classList.add("loading");

                                                fetch(formURL, {
                                                    method: form.method || "post",
                                                    body: data,
                                                    headers: {
                                                        'Accept': 'application/json'
                                                    }
                                                })
                                                .then(response => {
                                                    if (!response.ok) {
                                                        btn.classList.remove("loading");
                                                        statusText.textContent = errorMessage;
                                                        status.classList.add("kg-callout-card-red");
                                                        return;
                                                    }          

                                                    btn.classList.remove("loading");
                                                    form.reset();
                                                    statusText.textContent = successMessage;
                                                    status.classList.add("kg-callout-card-green");
                                                })
                                                .catch(error => {
                                                    btn.classList.remove("loading");
                                                    statusText.textContent = errorMessage;
                                                    status.classList.add("kg-callout-card-red");
                                                });
                                            }
                                            
                                            form.addEventListener("submit", handleSubmit);
                                        </script>                        
                                    {{/if}}
                                {{/match}}
                            {{/foreach}}
                        {{/if}}                      
                    </div>

                </div>       
            </div>
        </div>
    </div>
</div>
{{/post}}
