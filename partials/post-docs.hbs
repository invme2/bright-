{{#contentFor "extra-header-class"}} has-breadcrumbs border-b lg:border-gray-950/5 lg:dark:border-gray-50/5 {{/contentFor}}
{{#contentFor "extra-footer-class"}} no-space-top {{/contentFor}}

{{#has tag="#folders-col"}}
    {{> document filterTagPrefix="hash-docs-col" indexPage=. post=. isFolder=true }}
{{else}}
    {{#foreach tags limit="1"}}
        {{#get "posts" filter="tags:hash-folders-col+tags:{{slug}}" limit="1" include="tags" order="published_at asc" as |posts|}}
            {{> document filterTagPrefix="hash-docs-col" indexPage=posts.[0] post=../.. }}
        {{/get}}
    {{/foreach}}
{{/has}}


