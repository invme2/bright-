<a href="{{url absolute="true"}}" 
    class="{{class}} {{post_class}} relative p-6 flex flex-col text-start rounded-2xl border border-transparent"
    {{#if isPaginated }} data-sx-pagination-post {{/if}}
>
    {{!-- Background --}}
    <div class="dark:hidden absolute -inset-px -z-10 rounded-inherit bg-white shadow-pretty [:hover>&]:shadow-pretty-sm transition-shadow duration-200"></div>
    <div class="hidden dark:block absolute -inset-px z-10 rounded-inherit bg-linear-to-br from-gray-400/10 to-50% pointer-events-none"></div>
    <div class="hidden dark:block absolute -inset-px -z-10 rounded-inherit bg-white/1 [:hover>&]:bg-white/5 inset-shadow-md inset-shadow-white/2 transition-colors duration-500"></div>

    {{!-- Border --}}
    <div class="hidden dark:block absolute -z-10 -inset-0.5 mask-to-b mask-position-to-70% mask-opacity-to-20%">
        <div class="hidden dark:block absolute -z-10 inset-px rounded-2xl border border-gray-50/10"></div>
    </div>
    <div class="hidden dark:block absolute -z-10 -inset-px rounded-inherit border border-gray-50/5 [:hover>&]:opacity-80 {{#if isAnimated}} opacity-50 {{else}} opacity-0 {{/if}}"></div>

    {{!-- Shiny border --}}
    <div class="hidden dark:block absolute -z-10 -top-px start-5 w-1/3 h-px bg-linear-to-r from-white/0 to-white/0 via-gray-400/50"></div>

    {{!-- Animated border --}}
    {{#if isAnimated}}
        <div class="hidden md:block absolute -inset-px -z-10 rounded-inherit">
            <div class="absolute inset-0 rounded-inherit overflow-hidden">
                <div class="absolute -inset-px -z-10 p-[3px] rounded-inherit mask-content">
                    <div class="absolute -z-10 aspect-square top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2"
                        style="height: 10%; padding-left: 10%; padding-top: 10%;"                      
                    >
                        <div class="absolute inset-0 -z-10 dark:[--cg-color:rgba(255,255,255,40%)]"
                            style="
                                backface-visibility: hidden;
                                perspective: 1000;
                                background: conic-gradient(from calc(280deg + var(--angle, 0deg)) at 50% 50%, transparent 0deg, var(--cg-color, rgba(0,0,0, 40%)) 20%, transparent 22%);
                                animation: rotate-full 10s infinite linear;
                                transform: scale(15);                                                        
                            "                      
                        >
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {{/if}}

    {{!-- Shiny hover animation --}}
    <div class="hidden dark:block absolute -inset-px z-10 rounded-inherit overflow-hidden pointer-events-none">
        <div 
            class="hidden md:block absolute inset-0 z-10 w-full h-full rounded-inherit opacity-0 bg-linear-to-r from-white/0 from-40% to-white/0 to-60% via-white/20 [:hover>*>&]:animate-shine pointer-events-none" 
            style="background-size: 200% auto; background-position: 50%;">
        </div>
    </div>

    <div>
        {{#foreach tags visibility="internal"}} 
            {{#if canonical_url}}
                {{#match slug "~^" "hash-showcase-url-" }} 
                    <div class="hidden first:flex mb-2 items-center w-full text-2xs text-gray-500 dark:text-gray-400">
                        <span class="max-w-full truncate">
                            {{readable_url canonical_url }}
                        </span>
                        {{> icons/chevron-right-micro class="shrink-0 w-3 h-3 ms-0.5 opacity-85"}}
                    </div>
                {{/match}}
            {{/if}}
        {{/foreach}}     
    </div>

    <h2 class="font-medium leading-snug tracking-tight text-lg text-gray-950 dark:text-gray-100">
        {{title}}
    </h2>

    {{#if custom_excerpt}}
        <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">
            {{custom_excerpt}}
        </p>
    {{/if}}   

    {{#if feature_image}}
        <figure class="relative -end-px mt-auto pt-6 -me-6">
            <div class="relative rounded-md lg:rounded-xl rounded-r-none! overflow-hidden
                    {{#with ./page}}
                        {{#has tag="#temp-cards-img-1-1"}} 
                            aspect-1/1
                        {{else has tag="#temp-cards-img-3-4"}} 
                            aspect-3/4
                        {{else has tag="#temp-cards-img-4-3"}} 
                            aspect-4/3
                        {{else has tag="#temp-cards-img-4-5"}} 
                            aspect-4/5
                        {{else has tag="#temp-cards-img-5-4"}}
                            aspect-5/4
                        {{else has tag="#temp-cards-img-9-16"}}
                            aspect-9/16
                        {{else has tag="#temp-cards-img-16-9"}}
                            aspect-16/9
                        {{else}}
                            aspect-4/3
                        {{/has}}  
                    {{else}}
                        aspect-4/3
                    {{/with}}                  
                "
            >
                <picture>
                    <source
                        type="image/avif"                                
                        data-sizes="auto"
                        data-srcset="{{> srcset format="avif"}}"
                        srcset="{{img_url feature_image size="xxs" format="avif"}}"
                        src="{{img_url feature_image size="xl" format="avif"}}"
                    />
                    <source
                        type="image/webp"                                
                        data-sizes="auto"
                        data-srcset="{{> srcset format="webp"}}"
                        srcset="{{img_url feature_image size="xxs" format="webp"}}"
                        src="{{img_url feature_image size="xl" format="webp"}}"
                    />
                    <img
                        class="lazyload absolute inset-0 w-full h-full object-cover bg-gray-100 dark:bg-gray-900 [&.lazyloaded]:bg-transparent!"
                        data-sizes="auto"
                        data-srcset="{{> srcset }}"
                        srcset="{{img_url feature_image size="xxs"}}"
                        src="{{img_url feature_image size="xl"}}"
                        alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        loading="lazy"
                    />                   
                </picture>
            </div>
        </figure>     
    {{/if}}        
</a>