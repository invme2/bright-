<div class="outer xl:outer-xl">
    <div class="inner">
        <div class="group flex relative {{#indexPage}} {{#has tag="#groups-disabled"}} no-groups {{/has}} {{/indexPage}}">

            {{!-- Sidebar background --}}
            <div class="hidden lg:block dark:hidden absolute top-0 start-0 h-full w-screen -translate-x-full -ms-4">
                <div class="sticky top-16 w-full h-[calc(100vh-(--spacing(16)))] bg-gray-100/80 dark:bg-transparent"></div>
            </div>

            {{!-- Sidebar --}}
            {{#indexPage}}
                <div 
                    data-sx-sidebar 
                    class="fixed invisible lg:visible lg:h-[calc(100vh-(--spacing(16)))] lg:sticky lg:start-0 lg:top-16 lg:ps-4 lg:-ms-4 flex-none overflow-y-hidden
                        max-lg:[&.open]:visible max-lg:[&.open]:z-50 max-lg:inset-0 max-lg:-translate-x-full max-lg:[&.open]:translate-x-0
                    "
                >

                    <div data-sx-sidebar-close class="hidden max-lg:[.open>&]:block fixed -z-10 inset-0 bg-black/20 dark:bg-black/50 backdrop-blur-xs"></div>   

                    <div data-sx-sidebar-scroller class="h-full w-full max-w-xs lg:w-80 px-10 lg:ps-4 lg:-ms-4 pt-16 pb-20 lg:pb-8 relative z-10 bg-gray-50 dark:bg-gray-950 overflow-y-auto 
                        max-lg:ps-6 max-lg:-translate-x-full max-lg:[.open>&]:translate-x-0 max-lg:[.open>&]:shadow-lg max-lg:[.open>&]:transition max-lg:[.open>&]:ease-out
                        lg:bg-gray-100/80 lg:dark:bg-transparent border-e border-gray-950/5 dark:border-gray-50/5 scrollbar-width-thin">

                        <div class="block lg:hidden sticky top-0 h-0 w-full z-10">
                            <button data-sx-sidebar-close aria-label="{{t "Close"}}" class="-translate-y-12 translate-x-full flex items-center justify-center p-2 ms-auto rounded-md text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-gray-100 bg-gray-50 dark:bg-gray-950">
                                {{> icons/arrow-bar-to-left class="h-5 w-5 relative -start-1" }}
                            </button>    
                        </div>

                        <ul role="list" class="space-y-8 group-[.no-groups]:space-y-0">                    
                            {{#has tag="#groups-disabled"}} 
                                {{#get "posts" filter="tags:{{primary_tag.slug}}+tags:hash-lessons-col" order="published_at asc" limit="100" as |posts| }}
                                    {{> sidebar-section indexPage=.. posts=posts }}                                 
                                {{/get}}  
                            {{else}} 
                                {{#foreach tags visibility="internal"}}
                                    {{#match slug "~^" "hash-group-" }} 
                                        {{#>withThis groupTag=. indexPage=.. }}
                                            {{#get "posts" filter="tags:{{indexPage.primary_tag.slug}}+tags:{{groupTag.slug}}+tags:hash-lessons-col" order="published_at asc" limit="100" as |posts| }}
                                                {{> sidebar-section indexPage=../indexPage posts=posts tag=../groupTag}}                                 
                                            {{/get}}                                              
                                        {{/withThis}}
                                    {{/match}}                                    
                                {{/foreach}}  
                            {{/has}}
                        </ul>

                        {{#*inline "sidebar-meta"}}
                            <div {{#if isMain}} data-sx-progress="" {{/if}} class="{{extra-class}} hidden lg:block">
                                <div class="px-px">
                                    <div class="relative flex flex-col -ms-4 p-2.5 xl:px-4 xl:py-3 rounded-xl bg-white/90 dark:bg-background-dark/70 shadow-pretty dark:shadow-none backdrop-blur-md">
                                        {{#if isMain}}
                                            <div class="absolute z-10 top-0 start-0 w-full h-8 -translate-y-full bg-linear-to-t from-gray-100/80 dark:from-background-dark dark:via-background-dark/80 dark:opacity-80 pointer-events-none"></div>
                                        {{/if}}                                    
                                        <div class="absolute -inset-px z-10 dark:bg-white/5 rounded-xl border border-gray-950/5 dark:border-gray-50/5 pointer-events-none"></div>

                                        <a href="{{url absolute="true"}}" class="font-medium text-xs text-gray-700 hover:text-gray-950 dark:text-gray-400 dark:hover:text-gray-200 line-clamp-2 transition-colors duration-200">
                                            {{title}}
                                        </a>

                                        <div class="mt-4">
                                            <div class="flex justify-between text-2xs">
                                                <span data-sx-progress-count class="font-mono text-3xs"></span>
                                                <span class="space-x-0.5">
                                                    <a data-sx-progress-prev title="{{t "Previous"}}" href="#" class="opacity-50 pointer-events-none inline-flex w-4 h-4 rounded-sm shrink-0 items-center justify-center bg-gray-950/10 dark:bg-gray-50/5 transition-colors duration-200">
                                                        {{> icons/chevron-left class="flex-none w-3 h-3 text-gray-500 dark:text-gray-400"}}
                                                    </a>
                                                    <a data-sx-progress-next title="{{t "Next"}}" href="#" class="opacity-50 pointer-events-none inline-flex w-4 h-4 rounded-sm shrink-0 items-center justify-center bg-gray-950/10 dark:bg-gray-50/5 transition-colors duration-200">
                                                        {{> icons/chevron-right class="flex-none w-3 h-3 text-gray-500 dark:text-gray-400"}}
                                                    </a>
                                                </span>
                                            </div>
                                            <div class="mt-1 w-full h-0.5 relative">
                                                <div class="absolute inset-0 w-full h-0.5 bg-gray-300 dark:bg-black rounded-full"></div>
                                                <div data-sx-progress-bar class="absolute inset-0 h-0.5 w-0 max-w-full">
                                                    <div class="absolute inset-0 w-full h-0.5 bg-primary rounded-full"></div>
                                                    <div class="absolute start-0 -top-0.5 w-full h-2 rounded-full bg-primary opacity-15 dark:opacity-20 blur-xs"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>      
                                    <div class="relative -top-px -z-10 flex h-5 -mb-px -ms-4 py-3 bg-background dark:bg-background-dark">
                                        <div class="absolute inset-0 bg-gray-100/80 dark:bg-transparent"></div>
                                    </div>                  
                                </div>
                            </div>                        
                        {{/inline}}   

                        {{!-- Placeholder to keep enough spacing between the meta block & sidebar listing --}}
                        {{> sidebar-meta extra-class="invisible ms-1.5 -me-[30px] xl:ms-0 xl:-me-5 min-w-full w-auto"}}
                    </div>

                    {{!-- Sidebar meta block --}}
                    {{> sidebar-meta isMain=true extra-class="absolute bottom-0 start-0 z-10 w-full ps-[28px] pe-5 xl:ps-4 xl:pe-5"}}
                </div>
            {{/indexPage}}

            {{!-- Content --}}
            {{#post}}
                <div class="relative min-w-0 w-full grid grid-cols-1 xl:grid-cols-[auto_--spacing(56)]">
                    <div class="relative flex-auto min-w-0 px-0 lg:ps-outer xl:px-16 py-16 lg:pb-5">
                        {{!-- Grid pattern --}}
                        <div class="absolute -z-10 top-0 start-0 w-full h-40 bg-grid-gray-950 dark:bg-grid-gray-50 bg-grid-size-10 dark:bg-grid-size-10 mask-radial mask-position-to-80% mask-opacity-to-20% opacity-5 dark:opacity-10 pointer-events-none"></div>

                        <article data-sx-toc-src class="max-w-3xl mx-auto">
                            <header>
                                {{#foreach tags visibility="internal"}}
                                    {{#match slug "~^" "hash-group-" }}
                                        <span 
                                            class="badge hidden first:inline-flex mb-3 group-[.no-groups]:hidden"
                                            data-sx-text="{{description}}"
                                        >
                                            {{description}}
                                        </span>
                                    {{/match}}
                                {{/foreach}}

                                {{!-- Heading --}}
                                <h1 id="___TOCBOT___" class="-my-3 text-4xl text-pretty font-bold tracking-tight leading-tighter">
                                    <span class="inline-flex py-3 text-gray-950 dark:bg-linear-to-br from-gray-100 from-50% to-background-dark dark:bg-clip-text dark:text-transparent">
                                        {{title}}
                                    </span>
                                </h1>                                    

                                {{#if custom_excerpt}}
                                    <p class="mt-3 text-lg text-gray-600 dark:text-gray-400 text-pretty">{{custom_excerpt}}</p>
                                {{/if}}

                                {{#if feature_image}}
                                    <figure class="mt-5 has-links {{#if feature_image_caption}} has-figcaption {{/if}}">
                                        <div class="relative rounded-md lg:rounded-xl overflow-hidden 
                                                {{#has tag="#temp-media-1-1"}} 
                                                    aspect-1/1
                                                {{else has tag="#temp-media-3-4"}} 
                                                    aspect-3/4
                                                {{else has tag="#temp-media-4-3"}} 
                                                    aspect-4/3
                                                {{else has tag="#temp-media-4-5"}} 
                                                    aspect-4/5
                                                {{else has tag="#temp-media-5-4"}}
                                                    aspect-5/4
                                                {{else has tag="#temp-media-9-16"}}
                                                    aspect-9/16
                                                {{else}}
                                                    aspect-16/9
                                                {{/has}}
                                            "
                                        >     
                                            <picture>
                                                <source
                                                    type="image/avif"                                
                                                    data-sizes="auto"
                                                    data-srcset="{{> srcset format="avif"}}"
                                                    srcset="{{img_url feature_image size="xxs" format="avif"}}"
                                                    src="{{img_url feature_image size="2xl" format="avif"}}"
                                                />
                                                <source
                                                    type="image/webp"                                
                                                    data-sizes="auto"
                                                    data-srcset="{{> srcset format="webp"}}"
                                                    srcset="{{img_url feature_image size="xxs" format="webp"}}"
                                                    src="{{img_url feature_image size="2xl" format="webp"}}"
                                                />
                                                <img
                                                    class="lazyload absolute inset-0 w-full h-full object-cover bg-gray-100 dark:bg-gray-900 [&.lazyloaded]:bg-transparent!"
                                                    data-sizes="auto"
                                                    data-srcset="{{> srcset}}"
                                                    srcset="{{img_url feature_image size="xxs"}}"
                                                    src="{{img_url feature_image size="2xl"}}"
                                                    alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                                                />    
                                            </picture>                                                                             
                                        </div>
                                        {{#if feature_image_caption}}
                                            <figcaption>{{feature_image_caption}}</figcaption>
                                        {{/if}}
                                    </figure>
                                {{/if}}                            
                            </header>

                            <div class="mt-8 content">
                                {{content}}
                            </div>

                            {{!-- Updated on, comments, share, ...  --}}
                            {{> meta-bottom }}

                            {{!-- Next & Prev --}}
                            <div class="mt-16 flex flex-col sm:flex-row sm:space-x-8 js-toc-ignore">
                                <a href="#" data-sx-prev class="max-sm:hidden invisible flex flex-col basis-1/2 min-w-0 no-underline">
                                    <div class="ps-5 mb-1 text-2xs font-normal text-gray-500 dark:text-gray-400 [:hover>&]:text-gray-700 dark:[:hover>&]:text-gray-300 truncate transition-colors duration-200">
                                        {{t "Previous"}}
                                        <span data-sx-prev-group class="group-[.no-groups]:hidden"></span>
                                    </div>

                                    <div class="relative w-full flex">
                                        <div data-sx-prev-title class="ps-5 text-pretty text-xs font-medium text-gray-700 dark:text-gray-300 line-clamp-2"></div>
                                        {{> icons/chevron-left class="absolute start-0 top-0.5 mt-px w-3.5 h-3.5 flex-none text-gray-500 dark:text-gray-400 [:hover>*>&]:-translate-x-1 transition-transform duration-150" }}
                                    </div>
                                </a>
                                <a href="#" data-sx-next class="max-sm:hidden invisible flex flex-col basis-1/2 min-w-0 no-underline text-end mt-8 sm:mt-0 [.invisible~&]:mt-0">
                                    <div class="pe-5 mb-1 text-2xs font-normal text-gray-500 dark:text-gray-400 [:hover>&]:text-gray-700 dark:[:hover>&]:text-gray-300 truncate transition-colors duration-200">
                                        {{t "Next"}}
                                        <span data-sx-next-group class="group-[.no-groups]:hidden"></span>
                                    </div>

                                    <div class="relative w-full flex justify-end">
                                        <div data-sx-next-title class="pe-5 text-pretty text-xs font-medium text-gray-700 dark:text-gray-300 line-clamp-2"></div>
                                        {{> icons/chevron-right class="absolute end-0 top-0.5 mt-px w-3.5 h-3.5 flex-none text-gray-500 dark:text-gray-400 [:hover>*>&]:translate-x-1 transition-transform duration-150" }}
                                    </div>
                                </a>
                            </div>
                        </article>
                    </div>

                    {{!-- Right sidebar --}}
                    <aside  class="hidden xl:block flex-none w-56 pb-5">
                        <div class="invisible sticky top-32 mt-0.5 w-full grid grid-cols-1 gap-7">
                            {{!-- Table of contents --}}
                            <div data-sx-toc-container hidden="true" class="invisible">
                                <div class="flex mb-3 relative">
                                    <h2 class="text-2xs uppercase font-semibold tracking-wider text-gray-900 dark:text-gray-100">
                                        {{t "On this page"}}
                                    </h2>

                                    <button data-sx-toc-top aria-label="{{t "Back to top"}}" title="{{t "Back to top"}}" 
                                        class="absolute -top-1.5 -end-1.5 flex items-center justify-center rounded-sm p-1.5 hover:bg-gray-900/5 dark:hover:bg-gray-50/10 transition-colors duration-200"
                                    >
                                        {{> icons/arrow-up-micro class="w-3 h-3 text-gray-500 dark:text-gray-400" }} 
                                    </button>
                                </div>

                                <nav data-sx-toc-target class="-my-1.5 relative text-xs leading-4 text-gray-500 dark:text-gray-400 dark:[&_.current]:text-gray-300">
                                </nav>
                            </div>
                            
                            {{!-- CTA --}}
                            <div class="not-has-[a]:hidden">
                                {{#*inline "cta"}}
                                    <div data-sx-cta class="hidden first:block">
                                        <a href={{canonical_url}} class="relative block p-0.5 z-10 bg-background dark:bg-background-dark">
                                            <div class="relative p-4 rounded-xl">
                                                {{!-- Background --}}
                                                <div class="dark:hidden absolute -inset-px -z-10 rounded-xl bg-white shadow-pretty [:hover>&]:shadow-pretty-sm transition-shadow duration-200"></div>
                                                <div class="hidden dark:block absolute -inset-px z-10 rounded-xl bg-linear-to-br from-gray-400/10 to-50% pointer-events-none"></div>
                                                <div class="hidden dark:block absolute -inset-px -z-10 rounded-xl bg-white/1 [:hover>&]:bg-white/5 transition-colors duration-500 inset-shadow-md inset-shadow-white/2"></div>
                                                
                                                {{!-- Border --}}
                                                <div class="hidden dark:block absolute -z-10 -inset-0.5 mask-to-b mask-position-to-70% mask-opacity-to-50%">
                                                    <div class="hidden dark:block absolute -z-10 inset-px rounded-xl border border-gray-50/10"></div>
                                                </div>                                                
                                                <div class="hidden dark:block absolute -z-10 -inset-px rounded-xl border border-gray-50/5 [:hover>&]:opacity-80 opacity-0"></div>

                                                {{!-- Shiny border --}}
                                                <div class="hidden dark:block absolute -top-px start-5 w-1/3 h-px bg-linear-to-r from-white/0 to-white/0 via-gray-400/50"></div>

                                                <h2 class="text-pretty text-sm font-medium text-gray-900 dark:text-gray-100">
                                                    {{description}}
                                                </h2>

                                                {{#if meta_description}}
                                                    <p class="mt-1 text-pretty text-xs">{{meta_description}}</p>
                                                {{/if}}

                                                {{#if meta_title}}
                                                    <div class="mt-3 py-2 px-3 font-semibold text-xs text-center text-primary-contrast bg-primary rounded-full shadow-primary dark:shadow-none dark:drop-shadow-primary-sm hover:opacity-90 transition-opacity duration-200">
                                                        {{meta_title}}
                                                    </div>
                                                {{/if}}
                                            </div>
                                        </a>
                                    </div>                            
                                {{/inline}}

                                {{!-- Post cta --}}
                                {{#foreach tags visibility="internal"}}
                                    {{#match slug "~^" "hash-cta-" }}
                                        {{#if canonical_url}}
                                            {{> cta}}
                                        {{/if}}
                                    {{/match}}                                 
                                {{/foreach}}

                                {{!-- Collection cta --}}
                                {{#with ../indexPage}}
                                    {{#foreach tags visibility="internal"}}
                                        {{#match slug "~^" "hash-cta-" }}
                                            {{#if canonical_url}}
                                                {{> cta}}
                                            {{/if}}
                                        {{/match}}                                 
                                    {{/foreach}}   
                                {{/with}}
                            </div>
                        </div>
                    </aside>
                </div>
            {{/post}}
        </div>
    </div>
</div>