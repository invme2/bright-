{{#contentFor "extra-footer-class"}} no-space-top {{/contentFor}}

{{!-- Grid pattern --}}
<div class="absolute -z-10 top-10 start-0 w-full h-70 bg-grid-gray-950 dark:bg-grid-gray-50 bg-grid-size-10 dark:bg-grid-size-10 lg:bg-grid-size-15 dark:lg:bg-grid-size-15 mask-radial mask-position-to-80% opacity-5 dark:opacity-10 pointer-events-none"></div>


{{!-- Hero section --}}
{{> hero }}


<div class="outer xl:outer-xl">
    <div class="inner">

        <div class="max-w-5xl mx-auto grid gap-0 xl:gap-20 grid-cols-1 xl:grid-cols-[auto_--spacing(56)]">
            <div class="w-full min-w-0 max-w-3xl sm:mx-auto xl:mx-0">
                {{!-- Content --}}
                <div data-sx-toc-src>
                    {{!-- Fix for tocbot always having the first link active even if the heading is not yet visible https://github.com/tscanlin/tocbot/issues/217 --}}
                    <h2 id="___TOCBOT___" class="sr-only m-0">
                        <span aria-hidden="true">{{title}}</span>
                    </h2>  

                    <div class="content">
                        {{content}}
                    </div>
                </div>

                {{!-- Authors --}}
                {{> authors-bio }}            

                {{!-- Updated on, comments, share, ...  --}}
                {{> meta-bottom }}          
            </div>

            {{!-- Right sidebar --}}
            <aside  class="hidden xl:block flex-none w-56">
                <div class="invisible sticky top-26 mt-0.5 w-full grid grid-cols-1 gap-7">
                    {{!-- Table of contents --}}
                    <div data-sx-toc-container hidden="true" class="invisible">
                        <div class="flex mb-3 relative">
                            <h2 class="text-2xs uppercase font-semibold tracking-wider text-gray-900 dark:text-gray-100">
                                {{t "On this page"}}
                            </h2>

                            <button data-sx-toc-top aria-label="{{t "Back to top"}}" title="{{t "Back to top"}}" 
                                class="absolute -top-1.5 -end-1.5 flex items-center justify-center rounded-sm p-1.5 hover:bg-gray-900/5 dark:hover:bg-gray-50/10 transition-colors duration-200"
                            >
                                {{> icons/arrow-up-micro class="w-3 h-3 text-gray-500 dark:text-gray-400" }} 
                            </button>
                        </div>

                        <nav data-sx-toc-target class="-my-1.5 relative text-xs leading-4 text-gray-500 dark:text-gray-400 dark:[&_.current]:text-gray-300">
                        </nav>
                    </div>
                    
                    {{!-- CTA --}}
                    <div class="not-has-[a]:hidden">
                        {{#*inline "cta"}}
                            <div data-sx-cta class="hidden first:block">
                                <a href={{canonical_url}} class="relative block p-0.5 z-10 bg-background dark:bg-background-dark">
                                    <div class="relative p-4 rounded-xl">
                                        {{!-- Background --}}
                                        <div class="dark:hidden absolute -inset-px -z-10 rounded-xl bg-white shadow-pretty [:hover>&]:shadow-pretty-sm transition-shadow duration-200"></div>
                                        <div class="hidden dark:block absolute -inset-px z-10 rounded-xl bg-linear-to-br from-gray-400/10 to-50% pointer-events-none"></div>
                                        <div class="hidden dark:block absolute -inset-px -z-10 rounded-xl bg-white/1 [:hover>&]:bg-white/5 transition-colors duration-500 inset-shadow-md inset-shadow-white/2"></div>
                                        
                                        {{!-- Border --}}
                                        <div class="hidden dark:block absolute -z-10 -inset-0.5 mask-to-b mask-position-to-70% mask-opacity-to-50%">
                                            <div class="hidden dark:block absolute -z-10 inset-px rounded-xl border border-gray-50/10"></div>
                                        </div>                                                
                                        <div class="hidden dark:block absolute -z-10 -inset-px rounded-xl border border-gray-50/5 [:hover>&]:opacity-80 opacity-0"></div>

                                        {{!-- Shiny border --}}
                                        <div class="hidden dark:block absolute -top-px start-5 w-1/3 h-px bg-linear-to-r from-white/0 to-white/0 via-gray-400/50"></div>

                                        <h2 class="text-pretty text-sm font-medium text-gray-900 dark:text-gray-100">
                                            {{description}}
                                        </h2>

                                        {{#if meta_description}}
                                            <p class="mt-1 text-pretty text-xs">{{meta_description}}</p>
                                        {{/if}}

                                        {{#if meta_title}}
                                            <div class="mt-3 py-2 px-3 font-semibold text-xs text-center text-primary-contrast bg-primary rounded-full shadow-primary dark:shadow-none dark:drop-shadow-primary-sm hover:opacity-90 transition-opacity duration-200">
                                                {{meta_title}}
                                            </div>
                                        {{/if}}
                                    </div>
                                </a>
                            </div>                            
                        {{/inline}}

                        {{#foreach tags visibility="internal"}}
                            {{#match slug "~^" "hash-cta-" }}
                                {{#if canonical_url}}
                                    {{> cta}}
                                {{/if}}
                            {{/match}}                                 
                        {{/foreach}}                        
                    </div>
                </div>
            </aside>
        </div>

        <div class="max-w-5xl mx-auto">
            {{!-- Next & Prev --}}       
            <div class="my-20 lg:mb-5">
                {{#foreach tags visibility="internal"}}
                    {{#match slug "~^" "hash-showcase-col" }}
                        <div class="hidden first:flex flex-col sm:flex-row sm:space-x-8 js-toc-ignore">
                            {{#> withThis collectionTagSlug=slug postSlug=../slug postPublishedAt=(date ../published_at format="YYYY-MM-DD HH:mm:ss") }}
                                {{#get "posts" filter="tags:{{collectionTagSlug}}+slug:-{{postSlug}}+published_at:<='{{postPublishedAt}}'" order="published_at desc" limit="1" fields="title, url" as |posts| }}
                                    {{#if posts}}
                                        <a href="{{posts.[0].url}}" class="flex flex-col basis-1/2 min-w-0 no-underline">
                                            <div class="ps-5 mb-1 text-2xs font-normal text-gray-500 dark:text-gray-400 [:hover>&]:text-gray-700 dark:[:hover>&]:text-gray-300 truncate transition-colors duration-200">
                                                {{t "Previous"}}
                                            </div>

                                            <div class="relative w-full flex">
                                                <div class="ps-5 text-pretty text-xs font-medium text-gray-700 dark:text-gray-300 line-clamp-2">
                                                    {{posts.[0].title}}
                                                </div>
                                                {{> icons/chevron-left class="absolute start-0 top-0.5 mt-px w-3.5 h-3.5 flex-none text-gray-500 dark:text-gray-400 [:hover>*>&]:-translate-x-1 transition-transform duration-150" }}
                                            </div>
                                        </a> 
                                    {{else}}
                                        <div class="max-sm:hidden invisible flex flex-col basis-1/2 min-w-0 no-underline"></div>
                                    {{/if}}
                                {{/get}}
                                
                                {{#get "posts" filter="tags:{{collectionTagSlug}}+slug:-{{postSlug}}+published_at:>'{{postPublishedAt}}'" order="published_at asc" limit="1" fields="title, url" as |posts| }}
                                    {{#if posts}}
                                        <a href="{{posts.[0].url}}" class="flex flex-col basis-1/2 min-w-0 no-underline text-end mt-8 sm:mt-0 [.invisible~&]:mt-0">
                                            <div class="pe-5 mb-1 text-2xs font-normal text-gray-500 dark:text-gray-400 [:hover>&]:text-gray-700 dark:[:hover>&]:text-gray-300 truncate transition-colors duration-200">
                                                {{t "Next"}}
                                            </div>

                                            <div class="relative w-full flex justify-end">
                                                <div class="pe-5 text-pretty text-xs font-medium text-gray-700 dark:text-gray-300 line-clamp-2">
                                                    {{posts.[0].title}}
                                                </div>
                                                {{> icons/chevron-right class="absolute end-0 top-0.5 mt-px w-3.5 h-3.5 flex-none text-gray-500 dark:text-gray-400 [:hover>*>&]:translate-x-1 transition-transform duration-150" }}
                                            </div>
                                        </a>
                                    {{else}}
                                        <div class="max-sm:hidden invisible flex flex-col basis-1/2 min-w-0 no-underline text-end mt-8 sm:mt-0 [.invisible~&]:mt-0"></div>
                                    {{/if}}
                                {{/get}}
                            {{/withThis}}
                        </div>
                    {{/match}}
                {{/foreach}}
            </div>
        </div>
    </div>
</div>

<div class="sticky bottom-0 z-10">
    {{#foreach tags visibility="internal"}} 
        {{#if canonical_url}}
            {{#match slug "~^" "hash-showcase-url-" }} 
                <a 
                    id="sx-showcase-link-sticky"
                    href="{{canonical_url}}" 
                    class="hidden first:flex  outer xl:outer-xl  w-full mt-10 py-4 items-center border-t border-gray-950/5 dark:border-gray-50/5 
                        text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-100 bg-white dark:bg-background-dark/70 backdrop-blur-sm transition duration-200 
                    " 
                >
                    <div class="inner relative max-w-5xl mx-auto flex flex-wrap items-center sm:flex-nowrap gap-4">
                        <span class="font-medium text-pretty text-sm text-gray-950 dark:text-gray-100 line-clamp-2 sm:line-clamp-1">
                            {{../title}}
                        </span>

                        <span class="ms-auto flex-none inline-flex items-center
                            py-2 px-3 font-semibold text-xs text-center text-primary-contrast bg-primary rounded-full shadow-primary dark:shadow-none dark:drop-shadow-primary-sm hover:opacity-90 transition-opacity duration-200
                        ">                        
                            {{t "Go to website"}}

                            {{> icons/arrow-up-right class="relative top-px ms-0.5 -me-1 w-3.5 h-3.5 [:hover>*>*>&]:translate-x-0.5 [:hover>*>*>&]:-translate-y-0.5 transition-transform duration-150"}}
                        </span>

                        <span class="hidden dark:block absolute start-0 -top-4 w-full h-10 rounded-full opacity-20" style="background: radial-gradient(50% 100% at 50% 0%, rgba(255, 255, 255, 0.2) 0%, rgba(0, 0, 0, 0) 100%);"></span>                
                    </div>    
                </a>
            {{/match}}
        {{/if}}
    {{/foreach}}
</div>