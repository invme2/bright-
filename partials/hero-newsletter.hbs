<div id="sx-hero" class="{{hero_class}} outer xl:outer-xl relative text-lg max-w-none py-16 sm:py-20 md:py-28">
    <div class="inner grid grid-cols-1 {{#if feature_image}} lg:grid-cols-2 {{/if}} {{#has tag="#newsletter-preview"}} lg:grid-cols-2 {{/has}} gap-20 items-center">
        <div class="w-full max-w-3xl mx-auto {{#if feature_image}} mx-0! {{/if}} {{#has tag="#newsletter-preview"}} mx-0! {{/has}}">
            {{!-- Heading --}}
            <h1 class="-mt-3 mb-0 max-w-3xl text-4xl xl:text-5xl font-bold tracking-tight leading-tighter">
                <span class="py-3 text-gray-950 dark:bg-linear-to-br from-gray-100 from-50% to-background-dark dark:bg-clip-text dark:text-transparent">
                    {{title}}
                </span>
            </h1>    

            {{!-- Lead --}}
            {{#if html}}
                <div class="mt-6 max-w-2xl text-lg! text-gray-600 dark:text-gray-400 content content-enhanced">
                    {{{html}}}
                </div>
            {{else if custom_excerpt}}
                <p class="mb-0 mt-6 max-w-2xl text-lg text-gray-600 dark:text-gray-400">
                    {{custom_excerpt}}
                </p>
            {{/if}}

            {{!-- Subscribe Form --}}
            {{#if @site.members_enabled}}
                <div class="mt-10 flex-none lg:max-w-sm">
                    <button data-portal="signup" class="hover:[&_.glow]:opacity-10 flex items-center ps-5 pe-1 rounded-full h-12 w-full max-w-md lg:min-w-80 text-sm text-gray-500 bg-white shadow-xs ring-1 ring-inset ring-gray-950/10 dark:text-gray-400 dark:bg-white/5 dark:ring-white/10 dark:shadow-none">
                        <span aria-hidden="true" class="opacity-90 text-start truncate pr-2">{{t "Enter your email"}}</span>
                        <span class="[:hover>&]:opacity-80 dark:[:hover>&]:opacity-100 relative flex items-center ml-auto h-10 px-6 rounded-full bg-primary shadow-primary ring-inset ring-gray-950/10 dark:ring-1 dark:ring-white/10 dark:bg-white/5 dark:shadow-none transition-opacity duration-200">
                            <span class="hidden dark:block glow absolute inset-0 rounded-full transition-opacity duration-1000" style="background: radial-gradient(50% 100% at 50% 100%, rgba(255, 255, 255, 0.2) 0%, rgba(0, 0, 0, 0) 100%);"></span>
                            
                            <span class="text-primary-contrast font-medium dark:bg-linear-to-br dark:from-gray-50 dark:from-50% dark:bg-clip-text dark:text-transparent">
                                {{t "Subscribe"}}
                            </span>
                        </span>
                    </button>
                    <p class="mt-2 ps-5 text-2xs text-gray-600 dark:text-gray-400">
                        {{t "Unsubscribe anytime"}}
                        <span class="mx-1.5 opacity-85">·</span>
                        <a href="rss/" class=" hover:text-gray-950 dark:hover:text-gray-50 transition-colors duration-200">{{t "RSS feed"}}</a>
                    </p>
                </div>
            {{/if}}             
        </div>

        {{#has tag="#newsletter-preview"}} 
            {{!-- Preview --}}
            {{#get "posts" filter="tags:hash-newsletter-col+visibility:public" order="featured desc, published_at desc" include="tags,authors" limit="1" as |posts| }}
                {{#if posts}}
                    <div class="relative flex w-full py-px overflow-x-hidden scrollbar-width-none">
                        <div class="relative w-full md:max-w-[600px] lg:ms-auto">
                            {{#foreach posts limit="1"}}
                                <div class="relative w-full rounded-xl lg:rounded-2xl backdrop-blur-xs border border-gray-950/10 dark:border-gray-50/5 bg-white dark:bg-gray-50/1 hover:bg-white/90 dark:hover:bg-gray-50/3 transition-colors duration-300">
                                    {{!-- Background --}}
                                    <div class="hidden dark:block absolute -inset-px z-10 rounded-xl lg:rounded-2xl bg-linear-to-br from-gray-400/10 to-50%"></div>

                                    {{!-- Shiny border --}}
                                    <div class="hidden dark:block absolute -z-10 -top-px start-5 w-1/3 h-px bg-linear-to-r from-white/0 to-white/0 via-gray-400/50"></div>

                                    {{!-- Link --}}
                                    <a href="{{url absolute="true"}}" class="absolute block inset-0 z-10">
                                        <span class="sr-only">{{title}}</span>
                                    </a>

                                    <div aria-hidden="true" class="relative w-full aspect-3/4 md:aspect-auto sm:max-h-[700px] overflow-hidden rounded-xl lg:rounded-2xl mask-to-b mask-position-from-50%">
                                        <div class="px-4 h-7 flex items-center border-b border-gray-950/10 dark:border-gray-50/5">
                                            <div class="flex space-x-2">
                                                <span class="w-2 h-2 rounded-full bg-red-500 dark:bg-gray-800"></span>
                                                <span class="w-2 h-2 rounded-full bg-amber-500 dark:bg-gray-800"></span>
                                                <span class="w-2 h-2 rounded-full bg-green-500 dark:bg-gray-800"></span>
                                            </div>
                                        </div>
                                        <div class="px-4 py-2 border-b border-gray-950/10 dark:border-gray-50/5">
                                            <div class="flex items-baseline">
                                                <span class="font-medium text-xs text-gray-950 dark:text-gray-100">{{@site.title}}</span>
                                                <span class="text-2xs ms-1">&lt;newsletter@{{readable_url @site.url}}&gt;</span>
                                            </div>
                                            <div class="flex items-center text-2xs">{{t "to me"}} {{> icons/chevron-down-micro class="shrink-0 w-3 h-3 ms-0.5" }}</div>
                                        </div>
                                        <div class="py-10 px-4 lg:px-6 xl:px-10">
                                            <div class="">
                                                <h2 class="text-center leading-snug tracking-tight text-lg text-gray-950 dark:text-gray-100">
                                                    {{title}}
                                                </h2>
                                                <p class="mt-2 text-center text-xs text-gray-600 dark:text-gray-400">
                                                    {{#primary_author}}
                                                        {{{t "By {authors}" authors=name }}}
                                                    {{/primary_author}}
                                                    <span class="mx-1.5 opacity-85">·</span>
                                                    <time class="capitalize" datetime="{{date format="YYYY-MM-DD"}}">
                                                        {{date}}
                                                    </time>  
                                                    <span class="mx-1.5 opacity-85">·</span>  
                                                    <span>
                                                        {{t "View online"}} &rarr;
                                                    </span>
                                                </p>
                                            </div>

                                            <div class="mt-10 content scale-x-95 max-w-2xl mx-auto" style="">
                                                {{content words="180"}}
                                            </div>                                            
                                        </div>
                                    </div>
                                </div>
                            {{/foreach}}
                            <div class="hidden sm:grid lg:hidden absolute top-1/4 right-0 translate-x-full ps-4 gap-3 justify-end items-center w-32" aria-hidden="true">
                                <span class="text-xs text-center font-medium">
                                    {{t "Read a sample"}}
                                </span>
                                {{> icons/arrow-doodle class="-scale-100 w-20 h-20" }}
                            </div>                        
                        </div>
                    </div>
                {{/if}}
            {{/get}}        
        {{else}}
            {{!-- Image --}}
            {{#if feature_image}}
                <figure class="max-w-6xl has-links {{#if feature_image_caption}} has-figcaption {{/if}}">
                    <div class="relative rounded-md lg:rounded-xl overflow-hidden 
                                {{#has tag="#temp-img-1-1"}} 
                                    aspect-1/1
                                {{else has tag="#temp-img-3-4"}} 
                                    aspect-3/4
                                {{else has tag="#temp-img-4-3"}} 
                                    aspect-4/3
                                {{else has tag="#temp-img-4-5"}} 
                                    aspect-4/5
                                {{else has tag="#temp-img-5-4"}}
                                    aspect-5/4
                                {{else has tag="#temp-img-9-16"}}
                                    aspect-9/16
                                {{else}}
                                    aspect-16/9
                                {{/has}}                                
                            ">   
                        <img
                            class="lazyload absolute inset-0 w-full h-full object-cover bg-gray-100 dark:bg-gray-900 [&.lazyloaded]:bg-transparent!"
                            data-sizes="auto"
                            data-srcset="{{> srcset}}"
                            srcset="{{img_url feature_image size="xxs"}}"
                            src="{{img_url feature_image size="2xl"}}"
                            alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}"
                        />
                    </div>
                    {{#if feature_image_caption}}
                        <figcaption>{{feature_image_caption}}</figcaption>
                    {{/if}}
                </figure>       
            {{/if}}                    
        {{/has}}

    </div>
</div>