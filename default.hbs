<!DOCTYPE html>
<html dir="ltr"
    lang="{{ @site.locale }}" 
    class="group/html min-h-dvh no-js dark"
    data-sx-content-api-url="{{content_api_url}}"
    data-sx-content-api-key="{{content_api_key}}"
    data-prismjs-copy="{{t "Copy"}}" 
    data-prismjs-copy-error="{{t "Error"}}" 
    data-prismjs-copy-success="{{t "Copied"}}">
    <head>
        {{!-- Basic site meta --}}
        <meta charset="UTF-8">
        <meta name="HandheldFriendly" content="True" />
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{{meta_title page=(t " (Page %)")}}</title>


        {{!-- Preload criticial assets --}}
        <link rel="preload" as="style" href="{{asset "/built/main.min.css"}}" />
        <link rel="preload" as="script" href="{{asset "/built/main.min.js"}}" />  
        {{#if @site.logo}}<link rel="preload" href="{{@site.logo}}" as="image" fetchpriority="high" />{{/if}}
        {{#if @custom.dark_theme_logo}}<link rel="preload" href="{{@custom.dark_theme_logo}}" as="image" fetchpriority="high" />{{/if}}              

        {{!-- Critical scripts & styles inlined in `head` to avoid FOUC & content shifting --}}
        {{> head-inlined }}     

        {{!-- ZEXO Fonts: Outfit + JetBrains Mono --}}
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
        <style>
            :root {
                --font-body: 'Outfit';
                --font-headings: 'Outfit';
            }
        </style>   

        {{!-- Theme styles --}}
        <link href="{{asset "/built/main.min.css"}}" rel="stylesheet" type="text/css" />

        {{!-- ZEXO Design System — Aevo-matched overrides (inline for immediate effect) --}}
        <style>
            /* Force dark mode */
            :root,html,html.dark,html.light{color-scheme:dark!important}
            body,html.light body,html.dark body{
                background-color:#06060c!important;
                color:#a5a5a8!important;
                font-family:'Outfit',-apple-system,sans-serif!important;
                font-weight:300;line-height:1.75;font-size:16px;
            }
            /* Aevo color tokens */
            :root,html.dark,html.light{
                --color-background:#06060c;--color-background-dark:#06060c;
                --color-gray-950:#06060c;--color-gray-900:#0e0e14;
                --color-gray-800:#12121a;--color-gray-700:#18181e;
                --color-gray-600:#424246;--color-gray-500:#6a6a6d;
                --color-gray-400:#a5a5a8;--color-gray-300:#a5a5a8;
                --color-gray-200:rgba(255,255,255,0.08);
                --color-gray-100:#d0d0d2;--color-gray-50:#fff;
            }
            /* Typography */
            h1,h2,h3,h4,h5,h6,.has-headings-font{
                font-family:'Outfit',-apple-system,sans-serif!important;
                color:#fff!important;letter-spacing:-0.02em;
            }
            h1{font-weight:400;font-size:clamp(36px,7.5vw,64px);line-height:1.125;letter-spacing:0}
            h2{font-weight:600;font-size:clamp(22px,3.5vw,36px)}
            h3{font-weight:600;font-size:18px}
            /* Hero title — pure white, no gradient */
            #sx-hero h1 span{
                background:none!important;-webkit-background-clip:unset!important;
                background-clip:unset!important;-webkit-text-fill-color:unset!important;
                color:#fff!important;
            }
            #sx-hero .content,#sx-hero p{color:#a5a5a8!important;font-weight:300;font-size:16px}
            code,pre,.font-mono,kbd,samp{font-family:'JetBrains Mono',monospace!important}
            /* No underlines */
            a,a:link,a:visited,a:hover,a:active,a span{
                text-decoration:none!important;border-bottom:none!important;
                box-shadow:none!important;background-image:none!important;
            }
            /* Enable animations on hero without #temp-animation tag */
            @media not all and (prefers-reduced-motion){
                #sx-hero{--animation-duration:600ms;--animation-delay:100ms}
            }
            /* Hide decorative elements */
            #sx-spotlights,#sx-tone{display:none!important}
            [class*="bg-grid-"]{background:none!important}
            /* Header */
            #sx-header.stuck{
                background-color:rgba(6,6,12,0.92)!important;
                border-bottom-color:rgba(255,255,255,0.05)!important;
            }
            #sx-header nav a{color:#a5a5a8!important;font-size:14px;font-weight:400;transition:color .15s}
            #sx-header nav a:hover{color:#fff!important}
            /* Mobile menu */
            #sx-mobile-menu>div:last-child{background-color:#0e0e14!important}
            /* Content */
            .content{color:#a5a5a8}
            .content h1,.content h2,.content h3,.content h4{color:#fff}
            .content strong{color:#fff;font-weight:500}
            .content a{color:#fff!important}
            .content a:hover{opacity:.8}
            .content blockquote{border-left-color:rgba(255,255,255,0.08);color:#d0d0d2}
            .content hr{border-color:rgba(255,255,255,0.04)}
            .content figcaption{color:#424246;font-size:12px}
            .content code{background:#12121a!important;border:1px solid rgba(255,255,255,0.05);border-radius:4px;padding:2px 6px;font-size:14px;color:#a5a5a8}
            .content pre{background:#12121a!important;border:1px solid rgba(255,255,255,0.05);border-radius:12px}
            .content pre code{border:none;padding:0;background:transparent!important}
            /* Bookmark cards */
            .kg-bookmark-container{background:#12121a!important;border:1px solid rgba(255,255,255,0.05)!important;box-shadow:none!important;transition:background .2s}
            .kg-bookmark-container:hover{background:#18181e!important}
            .kg-bookmark-title{color:#fff!important;font-size:16px;font-weight:600}
            .kg-bookmark-description{color:#a5a5a8!important;font-size:14px}
            .kg-bookmark-metadata{color:#424246!important;font-size:12px}
            /* Ghost content buttons — Aevo style */
            .content .kg-button-card .kg-btn,
            .content .kg-button-card a.kg-btn-accent{
                border-radius:12px!important;box-shadow:none!important;filter:none!important;
                position:relative;overflow:hidden;
                background:transparent!important;background-color:transparent!important;
                border:1px solid rgba(255,255,255,0.1)!important;color:#fff!important;
                padding:14px 32px!important;font-weight:500;font-size:14px;transition:border-color .3s;
            }
            .content .kg-button-card .kg-btn:hover,
            .content .kg-button-card a.kg-btn-accent:hover{
                border-color:rgba(255,255,255,0.25)!important;opacity:1!important;
                background:transparent!important;background-color:transparent!important;
            }
            /* Animated border wrapper */
            .zx-btn-wrap{position:relative;display:inline-flex;border-radius:12px}
            .zx-btn-border{position:absolute;inset:-1px;border-radius:12px;opacity:0;overflow:hidden;transition:opacity .4s;pointer-events:none}
            .zx-btn-wrap:hover .zx-btn-border{opacity:1}
            .zx-btn-border::before{
                content:'';position:absolute;inset:0;border-radius:12px;
                background:conic-gradient(from 0deg at 50% 50%,transparent 0deg,rgba(75,0,255,0.7) 20deg,transparent 22deg);
                animation:zx-rotate-border 2s linear infinite;animation-play-state:paused;
            }
            .zx-btn-wrap:hover .zx-btn-border::before{animation-play-state:running}
            .zx-btn-mask{position:absolute;inset:1px;border-radius:11px;background:#06060c;pointer-events:none}
            .zx-btn-glow{position:absolute;inset:0;border-radius:12px;background:radial-gradient(90% 90% at 0% 0%,rgba(75,0,255,0.15),transparent);opacity:0;transition:opacity .5s;pointer-events:none}
            .zx-btn-wrap:hover .zx-btn-glow{opacity:1}
            @keyframes zx-rotate-border{to{transform:rotate(360deg)}}
            /* 3D Perspective Grid */
            .zx-grid-wrapper{position:relative;width:100%;height:280px;overflow:hidden;pointer-events:none;margin-top:-20px}
            .zx-grid-scene{position:absolute;inset:0;perspective:300px;perspective-origin:50% 30%;overflow:hidden}
            .zx-grid-plane{position:absolute;left:-50%;right:-50%;bottom:-60%;height:200%;transform:rotateX(60deg);transform-origin:center top}
            .zx-grid-surface{position:absolute;inset:0;background-image:linear-gradient(to right,rgba(255,255,255,0.08) 1px,transparent 1px),linear-gradient(to bottom,rgba(255,255,255,0.08) 1px,transparent 1px);background-size:80px 80px}
            .zx-grid-surface-1{animation:zx-grid-scroll 3s linear infinite}
            .zx-grid-surface-2{animation:zx-grid-scroll 3s linear infinite;animation-delay:-1.5s;opacity:.5;background-size:160px 160px}
            @keyframes zx-grid-scroll{0%{transform:translateY(-80px)}100%{transform:translateY(0)}}
            .zx-grid-plane::after{content:'';position:absolute;top:0;left:50%;width:1px;height:100%;background:linear-gradient(to bottom,rgba(75,0,255,0.3),rgba(75,0,255,0.05) 40%,transparent 70%);transform:translateX(-50%)}
            .zx-grid-plane::before{content:'';position:absolute;top:-2px;left:0;right:0;height:4px;background:linear-gradient(to right,transparent 20%,rgba(75,0,255,0.2) 40%,rgba(75,0,255,0.4) 50%,rgba(75,0,255,0.2) 60%,transparent 80%);filter:blur(2px)}
            .zx-grid-fade{position:absolute;inset:0;pointer-events:none;background:radial-gradient(ellipse 60% 100% at 50% 100%,transparent 0%,transparent 40%,#06060c 75%)}
            .zx-grid-fade::before{content:'';position:absolute;top:0;left:0;right:0;height:40%;background:linear-gradient(to bottom,#06060c,transparent)}
            .zx-grid-fade::after{content:'';position:absolute;bottom:0;left:0;right:0;height:20%;background:linear-gradient(to top,#06060c,transparent)}
            @media(max-width:640px){.zx-grid-wrapper{height:160px}}
            /* Secondary nav buttons */
            [data-portal="signin"],[data-members-signout]{color:#6a6a6d!important;font-size:14px}
            [data-portal="signin"]:hover,[data-members-signout]:hover{color:#fff!important}
            /* Search */
            [data-ghost-search]{color:#424246!important}
            [data-ghost-search]:hover{color:#fff!important}
            /* Selection */
            ::selection{background-color:rgba(75,0,255,0.3);color:#fff}
            /* Scrollbar */
            ::-webkit-scrollbar{width:6px}
            ::-webkit-scrollbar-track{background:#06060c}
            ::-webkit-scrollbar-thumb{background:#18181e;border-radius:3px}
            ::-webkit-scrollbar-thumb:hover{background:#424246}
            html{scrollbar-width:thin;scrollbar-color:#18181e #06060c}
            /* Footer */
            #sx-footer-copy{color:#424246;font-size:12px}
            #sx-footer-copy a{color:#424246!important}
            #sx-footer-copy a:hover{color:#fff!important}
            #sx-footer a{color:#6a6a6d!important;font-size:14px;transition:color .15s}
            #sx-footer a:hover{color:#fff!important}
        </style>

        {{!-- Theme scripts --}}
        <script src="{{asset "/built/main.min.js"}}" defer data-manual></script>        
        <script src="{{asset "/built/search/index.min.js"}}" defer type="module"></script>

        {{!-- This is a slot used to inject page specific styles/scripts if needed (before Ghost head) --}}
        {{{block "head-before"}}}

        {{!-- This is used by Ghost to output advanced SEO meta, structured data and other important settings --}}
        {{ghost_head exclude="search"}}

        {{!-- This is a slot used to inject page specific styles/scripts if needed (after Ghost head) --}}
        {{{block "head-after"}}}        
    </head>
    <body class="{{body_class}} {{block "extra-body-class"}} min-h-dvh antialiased overflow-x-hidden text-gray-500 bg-background dark:text-gray-400 dark:bg-background-dark [&.has-modal]:h-dvh [&.has-modal]:overflow-hidden {{#if @member.paid}} is-paid-member {{else if @member}} is-member {{else}} is-not-member {{/if}}">


        <div id="sx-viewport" class="min-h-dvh flex flex-col">
            {{!-- Accessibility enhancement that lets keyboard users and screen readers
            jumb to the main content without going through other elements (header,...) --}}
            <a href="#sx-main" class="sr-only focus:not-sr-only focus-within:not-sr-only outline-hidden">
                <span class="relative flex items-center justify-center w-full h-12 font-semibold text-gray-950 dark:text-gray-50 text-sm ring-3 ring-inset ring-accent">
                    {{t "Skip to main content"}}
                </span>
            </a>       

            {{!-- Site header --}}
            {{> header }}

            <main id="sx-main" tabindex="-1" class="flex-none outline-hidden">
                {{!-- This is used by page templates to inject their content here --}}
                {{{ body }}}
            </main>

            {{!-- Site footer --}}
            {{> footer }}
        </div>

        {{!-- PhotoSwipe (aka Lightbox) --}}
        {{> pswp }}

        {{!-- This is a slot used to inject page specific styles/scripts if needed (before Ghost foot) --}}
        {{{block "foot-before"}}}

        {{!-- This is used by Ghost to output important functional scripts --}}
        {{ghost_foot}}

        {{!-- This is a slot used to inject page specific styles/scripts if needed (after Ghost foot) --}}
        {{{block "foot-after"}}}     

        {{!-- Lazy loaded script  --}}
        <div id="sx-lazy-script" data-src="{{asset "/built/lazy.min.js"}}"></div>

        {{!-- ZEXO: Animated border on content buttons --}}
        <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.content .kg-button-card .kg-btn').forEach(function(btn) {
                var wrap = document.createElement('div');
                wrap.className = 'zx-btn-wrap';
                btn.parentNode.insertBefore(wrap, btn);
                wrap.appendChild(btn);
                // Animated border layer
                var border = document.createElement('div');
                border.className = 'zx-btn-border';
                wrap.insertBefore(border, btn);
                // Mask (covers inside so only edge glows)
                var mask = document.createElement('div');
                mask.className = 'zx-btn-mask';
                wrap.insertBefore(mask, btn);
                // Subtle glow
                var glow = document.createElement('div');
                glow.className = 'zx-btn-glow';
                wrap.insertBefore(glow, btn);
                // Remove old border from btn since wrapper handles it
                btn.style.border = 'none';
            });
        });
        </script>
    </body>
</html>