{
    "name": "bright",
    "description": "A premium Ghost theme by Spiritix",
    "demo": "https://bright.spiritix.co",
    "version": "2.0.0",
    "private": true,
    "engines": {
        "ghost": ">=5.0.0"
    },
    "author": {
        "name": "Spiritix",
        "email": "support@spiritix.co",
        "url": "https://spiritix.co"
    },
    "keywords": [
        "ghost",
        "theme",
        "ghost-theme",
        "spiritix"
    ],
    "scripts": {
        "dev": "gulp",
        "build": "gulp build",
        "css": "gulp css",
        "js": "gulp js",
        "zip": "npm run test && gulp zip",
        "vitest": "vitest ./assets",
        "test": "gscan .",
        "test:ci": "gscan --fatal --verbose .",
        "pretest": "gulp build"
    },
    "dependencies": {
        "@floating-ui/dom": "1.7.4",
        "flexsearch": "0.8.212",
        "lazysizes": "5.3.2",
        "photoswipe": "4.1.3",
        "preact": "10.27.2",
        "prismjs": "1.30.0",
        "reframe.js": "4.0.2",
        "sal.js": "0.8.5",
        "tocbot": "4.36.4"
    },
    "devDependencies": {
        "@csstools/css-parser-algorithms": "3.0.5",
        "@csstools/css-tokenizer": "3.0.4",
        "@csstools/utilities": "2.0.0",
        "@rollup/plugin-node-resolve": "16.0.3",
        "@rollup/plugin-terser": "0.4.4",
        "@tailwindcss/postcss": "4.0.17",
        "autoprefixer": "10.4.22",
        "beeper": "3.0.0",
        "cssnano": "7.1.2",
        "del": "8.0.1",
        "gscan": "5.2.1",
        "gulp": "5.0.1",
        "gulp-concat": "2.6.1",
        "gulp-livereload": "4.0.2",
        "gulp-postcss": "10.0.0",
        "gulp-replace": "1.1.4",
        "gulp-uglify": "3.0.2",
        "gulp-zip": "6.1.0",
        "nock": "14.0.10",
        "ordered-read-streams": "2.0.0",
        "postcss": "8.5.6",
        "postcss-media-minmax": "5.0.0",
        "rollup": "4.53.2",
        "tailwindcss": "4.0.17",
        "vitest": "3.2.4"
    },
    "browserslist": [
        "defaults"
    ],
    "config": {
        "posts_per_page": 30,
        "image_sizes": {
            "xxs": {
                "width": 30
            },
            "xs": {
                "width": 100
            },
            "s": {
                "width": 400
            },
            "m": {
                "width": 800
            },
            "l": {
                "width": 1200
            },
            "xl": {
                "width": 1600
            },
            "2xl": {
                "width": 2400
            }
        },
        "card_assets": true,
        "custom": {
            "dark_theme_logo": {
                "type": "image",
                "description": "This logo will only be displayed on dark mode. Make sure it's the same size as the light mode one."
            },
            "dark_theme_accent_color": {
                "type": "color",
                "default": "#000000",
                "description": "This accent color will only be used on dark mode. Leave #000000 to disable."
            },
            "default_color_scheme": {
                "type": "select",
                "options": [
                    "Dark",
                    "Light",
                    "System"
                ],
                "default": "Dark",
                "description": "Choose your website's default color scheme."
            },
            "grayscale": {
                "type": "select",
                "options": [
                    "Slate",
                    "Gray",
                    "Zinc",
                    "Stone",
                    "Neutral"
                ],
                "default": "Gray",
                "description": "Choose different shades of gray used in text, borders, shadows ..."
            },
            "tone": {
                "type": "select",
                "options": [
                    "Accent",
                    "Neutral"
                ],
                "default": "Neutral",
                "description": "Change the general tone of your website"
            },
            "body_font": {
                "type": "select",
                "options": [
                    "System sans-serif",
                    "Inter",
                    "Roboto",
                    "Raleway",
                    "Montserrat",
                    "Nunito Sans",
                    "Work Sans",
                    "Source Sans",
                    "System serif",
                    "Roboto Serif",
                    "Source Serif"
                ],
                "default": "System sans-serif",
                "description": "Choose a different text font. Fonts are loaded from Google fonts except for system fonts."
            },
            "headings_font": {
                "type": "select",
                "options": [
                    "System sans-serif",
                    "Inter",
                    "Roboto",
                    "Raleway",
                    "Montserrat",
                    "Nunito Sans",
                    "Work Sans",
                    "Source Sans",
                    "System serif",
                    "Roboto Serif",
                    "Source Serif",
                    "Playfair Display"
                ],
                "default": "System sans-serif",
                "description": "Choose a different headings font. Fonts are loaded from Google fonts except for system fonts."
            },
            "footer_description": {
                "type": "text",
                "default": "",
                "description": "Custom description displayed on the site footer. Defaults to the global site description."
            },
            "footer_signup_title": {
                "type": "text",
                "default": "Subscribe to our newsletter",
                "description": "Change the signup title text that's displayed on the site footer."
            },
            "footer_signup_description": {
                "type": "text",
                "default": "Get the latest posts and updates delivered to your inbox. <br> No spam. Unsubscribe anytime.",
                "description": "Change the signup description text displayed on the site footer (add <br> to force a new line)."
            },
            "footer_copyright": {
                "type": "text",
                "default": "",
                "description": "Change the copyright text that's displayed on the site footer."
            }
        }
    },
    "renovate": {
        "extends": [
            "@tryghost:theme"
        ]
    }
}
