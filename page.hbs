{{!< default}}

{{!-- Hero section --}}
{{#page}}
    {{> hero }}
{{/page}}


{{#post}}
<div class="outer xl:outer-xl">
    <div class="inner">
        <div class="max-w-5xl mx-auto grid mb-20">
            <div class="w-full min-w-0 max-w-3xl sm:mx-auto">
                {{!-- Content --}}
                <div data-sx-toc-src>
                    {{!-- Fix for tocbot always having the first link active even if the heading is not yet visible https://github.com/tscanlin/tocbot/issues/217 --}}
                    <h2 id="___TOCBOT___" class="sr-only m-0">
                        <span aria-hidden="true">{{title}}</span>
                    </h2>  

                    <div class="content has-full has-wide">
                        {{content}}
                    </div>
                </div>       
            </div>
        </div>
    </div>
</div>
{{/post}}